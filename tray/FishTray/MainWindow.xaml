<Window x:Class="FishTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大肥鱼" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <Border x:Name="Shell" Margin="14" CornerRadius="18" BorderThickness="1" BorderBrush="#2A3F7A" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource Bg1}" Offset="0"/>
                <GradientStop Color="{StaticResource Bg0}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.55"/>
        </Border.Effect>

        <!-- ClipToBounds 只按直角矩形裁，四个圆角外会露出顶栏底色和蓝光；Inner 在代码里按圆角另裁一次（MainWindow.ClipCorners） -->
        <Grid x:Name="Inner">
            <!-- 星空：顶部一团蓝光 + 星点（一部分会慢慢闪，见 MainWindow.DrawSky） -->
            <Rectangle x:Name="TopGlow" Height="300" VerticalAlignment="Top" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="1">
                        <GradientStop Color="#661E4FB0" Offset="0"/>
                        <GradientStop Color="#00071026" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- 画布高度只有 1，不撑开窗口；星点画在它外面，由外框裁剪 -->
            <Canvas x:Name="Sky" IsHitTestVisible="False" Width="372" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 固定顶栏：抬头（可拖动，关闭键永远在右上角）+ 搜索框。滚动时它不动。 -->
                <Border x:Name="TopBar" Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}" Background="#66050A1C" Padding="22,16,14,12">
                    <StackPanel>
                        <Grid x:Name="Header" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="Logo" Width="34" Height="34" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="大肥鱼" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#5A6A99" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                    <TextBlock x:Name="StatusText" Text="连接中…" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>
                            <ToggleButton x:Name="PinButton" Grid.Column="2" Style="{StaticResource PinDot}" VerticalAlignment="Top" Margin="0,0,2,0"/>
                            <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource CloseDot}" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- 搜索：输入后只显示匹配的表情、动作、小剧场 -->
                        <Border Margin="0,12,8,0" CornerRadius="10" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" x:Name="SearchBorder">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M5,0.6 A4.4,4.4 0 1 0 5,9.4 A4.4,4.4 0 1 0 5,0.6 M8.3,8.3 L12,12" Stroke="{StaticResource SubBrush}" StrokeThickness="1.4" StrokeEndLineCap="Round" Margin="11,0,0,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}"
                                         FontFamily="{StaticResource UiFont}" FontSize="13" Padding="8,7" VerticalContentAlignment="Center" MaxLength="30"/>
                                <TextBlock x:Name="SearchHint" Grid.Column="1" Text="搜索表情、动作、小剧场（Ctrl+F）" Style="{StaticResource Caption}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="SearchClear" Grid.Column="2" Style="{StaticResource CloseDot}" Width="26" Height="26" Margin="0,0,3,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <Button.RenderTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Button.RenderTransform>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="22,14,22,12">

                    <!-- 平时的设置：搜索时先收起，让出地方给结果 -->
                    <StackPanel x:Name="SettingsArea">

                    <!-- 出场开关 -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="在桌面上出场" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ShowHint" Text="关掉就收起，她在后台待命" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="ShowSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 陪伴：羁绊（竖条纹进度条 + 五个节点）+ 番茄钟（本机加，2026-11-08；羁绊条 2026-11-13 改版） -->
                    <Border x:Name="BondCard" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14,16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 羁绊 -->
                            <Grid x:Name="HeartRow" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 羁绊图标：五级各一个，同一条虎鲸尾巴逐级升级（BondIcon.cs 里画） -->
                                <Border x:Name="BondIconHost" Width="40" Height="40" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LevelName" Text="初识" FontSize="14" FontWeight="SemiBold"/>
                                        <Border CornerRadius="7" Padding="6,1" Margin="7,1,0,0" VerticalAlignment="Center" Background="#337CC4FF" BorderBrush="#667CC4FF" BorderThickness="1">
                                            <TextBlock x:Name="LevelBadge" Text="Lv1" FontSize="10.5" FontWeight="SemiBold" Foreground="#BFE3FF"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="LevelHint" Text="羁绊 · 多陪陪她，会慢慢加深" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- 右边只放羁绊值，不再写 / 200（进度看下面的条）；下面是今天的涨跌 -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="PointsText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                                    <Border x:Name="TodayChip" CornerRadius="7" Padding="6,1" Margin="0,2,0,0" HorizontalAlignment="Right" Background="#1AFFFFFF">
                                        <TextBlock x:Name="TodayText" Text="今天还没变" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SubBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <!-- 羁绊条：整条是五个等级走到哪了，竖条纹，亮度往前端渐强（样子照用户给的参考图） -->
                            <Border x:Name="BondTrack" Height="22" Margin="0,13,0,0" CornerRadius="11" Background="#060C26" BorderBrush="#6FA8E8" BorderThickness="1.4" SnapsToDevicePixels="True">
                                <Border.Resources>
                                    <DrawingBrush x:Key="BondStripes" TileMode="Tile" Viewport="0,0,6,40" ViewportUnits="Absolute" Viewbox="0,0,6,40" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,40"/></GeometryDrawing.Geometry></GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Resources>
                                <Grid x:Name="BondInner" Margin="7,4" SnapsToDevicePixels="True">
                                    <!-- 还没走到的部分：很暗的竖条 -->
                                    <Border Background="#1A2858" OpacityMask="{StaticResource BondStripes}"/>
                                    <!-- 走过的部分：左暗右亮 -->
                                    <Border x:Name="BondFill" HorizontalAlignment="Left" Width="0" OpacityMask="{StaticResource BondStripes}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#28489A" Offset="0"/>
                                                <GradientStop Color="#4A90D8" Offset="0.55"/>
                                                <GradientStop Color="#B5E6FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- 五个节点和名字：节点在代码里按条的宽度摆 -->
                            <Canvas x:Name="BondNodes" Height="34" Margin="0,5,0,0"/>

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,13,0,13" Opacity="0.8"/>

                            <!-- 番茄钟 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="50" Height="50" VerticalAlignment="Center">
                                    <Ellipse Stroke="#1F3166" StrokeThickness="4"/>
                                    <Path x:Name="FocusArc" Stroke="{StaticResource AccentBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Effect><DropShadowEffect x:Name="FocusGlow" Color="#7CC4FF" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/></Path.Effect>
                                    </Path>
                                    <TextBlock x:Name="FocusTime" Text="25" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="FocusTitle" Text="专注陪伴" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="FocusHint" Text="她戴上眼镜陪你认真 25 分钟" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="FocusButton" Grid.Column="2" Style="{StaticResource PillAccent}" Content="开始" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 外观 -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14,16,8" Margin="0,0,0,6">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="大小" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="ScaleValue" Text="1.5×" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <Slider x:Name="ScaleSlider" Style="{StaticResource StarSlider}" Minimum="0.5" Maximum="2" SmallChange="0.1" LargeChange="0.1" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                            <Grid x:Name="ScaleMarks" Height="18" Margin="0,0,0,14"/>

                            <TextBlock Text="体型" Style="{StaticResource Caption}"/>
                            <Border x:Name="ShapeHost" Background="#6608102F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,16"/>

                            <TextBlock Text="衣服和配饰" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="DressPanel"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                    <!-- 常用：右键任意按钮加入 / 移出 -->
                    <Border x:Name="FavCard" Visibility="Collapsed" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12,16,4" Margin="0,6,0,12">
                        <StackPanel>
                            <TextBlock Text="★ 常用" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="FavPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- 表情 / 动作 / 小剧场：可展开收起 -->
                    <StackPanel x:Name="SectionsHost"/>
                    <TextBlock x:Name="FavHint" Text="小技巧：右键点任意按钮，加入“★ 常用”，常用的就摆在最上面。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,0,4,8"/>
                    <TextBlock x:Name="EmptyHint" Visibility="Collapsed" Text="没有找到，换个词试试。" Style="{StaticResource Caption}" Margin="4,8,4,8"/>

                    <StackPanel x:Name="MoreArea">
                    <ToggleButton x:Name="MoreToggle" Style="{StaticResource MoreRow}"/>

                    <!-- 更多设置 -->
                    <StackPanel x:Name="MorePanel" Visibility="Collapsed">
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14,16,14" Margin="0,2,0,12">
                            <StackPanel>
                                <TextBlock Text="流畅度（帧率）" Style="{StaticResource Caption}"/>
                                <Border x:Name="FpsHost" Background="#6608102F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,16"/>

                                <TextBlock Text="清晰度（立绘）" Style="{StaticResource Caption}"/>
                                <Border x:Name="QualityHost" Background="#6608102F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,16"/>

                                <Grid>
                                    <TextBlock Text="小动作间隔" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="IdleValue" Text="40 秒" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                                <Slider x:Name="IdleSlider" Style="{StaticResource StarSlider}" Minimum="0" Maximum="15" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                                <Grid x:Name="IdleMarks" Height="18" Margin="0,0,0,14"/>

                                <Grid>
                                    <TextBlock Text="气泡大小" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="BubbleValue" Text="1.0×" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                                <Slider x:Name="BubbleSlider" Style="{StaticResource StarSlider}" Minimum="0.5" Maximum="2" SmallChange="0.1" LargeChange="0.1" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                                <Grid x:Name="BubbleMarks" Height="18" Margin="0,0,0,14"/>

                                <TextBlock Text="气泡停留" Style="{StaticResource Caption}"/>
                                <Border x:Name="StayHost" Background="#6608102F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,6" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,8">
                                    <TextBlock Text="听音乐跳舞" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SwMusicDance" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <TextBlock Text="视线跟着鼠标" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SwFollow" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <TextBlock Text="别的程序全屏时藏起来" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SwFull" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <TextBlock Text="启动时先收起" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SwStartHidden" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <TextBlock Text="拖到屏幕边弹回来" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SwKeepOn" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <TextBlock Text="哄睡提醒（00:30 起）" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SwCoaxSleep" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <TextBlock Text="午饭提醒（11:30）" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SwCoaxLunch" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 最底下：检查更新（动作，不是开关；结果就写在按钮下面） -->
                        <StackPanel Margin="0,0,0,14">
                            <Button x:Name="UpdateButton" Style="{StaticResource Ghost}" Content="检查更新" HorizontalAlignment="Left" Padding="18,7"/>
                            <TextBlock x:Name="UpdateNote" Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>

                    </StackPanel>
                    </StackPanel>

                </StackPanel>
                </ScrollViewer>

                <!-- 固定底栏：随时让她说话、一键恢复平常 -->
                <Border x:Name="Footer" Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineBrush}" Background="#80050A1C" Padding="22,10,22,12">
                    <StackPanel>
                        <TextBlock x:Name="Toast" Text="" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,7" Visibility="Collapsed"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="SayBox" Style="{StaticResource Input}" MaxLength="200"/>
                                <TextBlock x:Name="SayHint" Text="让她说一句话，回车发送" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <Button x:Name="SayButton" Grid.Column="1" Style="{StaticResource Ghost}" Content="说" Margin="8,0,0,0"/>
                            <Button x:Name="ResetButton" Grid.Column="2" Style="{StaticResource Ghost}" Content="恢复平常" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- 顶栏上层的星光：只在抬头那一行的空白处（名字右边、图钉左边），压在顶栏半透明底色上面，所以看得清；不挡点击 -->
            <Canvas x:Name="TopSky" IsHitTestVisible="False" Width="372" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>
    </Border>
</Window>
