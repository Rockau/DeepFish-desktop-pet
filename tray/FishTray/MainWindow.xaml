<Window x:Class="FishTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FishTray"
        Title="DeepFish" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <Border x:Name="Shell" Margin="14" CornerRadius="18" BorderThickness="1" BorderBrush="#2A3F7A" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource Bg1}" Offset="0"/>
                <GradientStop Color="{StaticResource Bg0}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.55"/>
        </Border.Effect>

        <!-- ClipToBounds 只按直角矩形裁，四个圆角外会露出顶栏底色和蓝光；Inner 在代码里按圆角另裁一次（MainWindow.ClipCorners） -->
        <Grid x:Name="Inner">
            <!-- 星空：顶部一团蓝光 + 星点（一部分会慢慢闪，见 MainWindow.DrawSky） -->
            <Rectangle x:Name="TopGlow" Height="300" VerticalAlignment="Top" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="1">
                        <GradientStop Color="#661E4FB0" Offset="0"/>
                        <GradientStop Color="#00071026" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- 画布高度只有 1，不撑开窗口；星点画在它外面，由外框裁剪 -->
            <Canvas x:Name="Sky" IsHitTestVisible="False" Width="372" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 固定顶栏：抬头（可拖动，关闭键永远在右上角）+ 搜索框。滚动时它不动。 -->
                <Border x:Name="TopBar" Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}" Background="#66050A1C" Padding="22,16,14,12">
                    <StackPanel>
                        <Grid x:Name="Header" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="Logo" Width="34" Height="34" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="大肥鱼" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#5A6A99" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                    <TextBlock x:Name="StatusText" Text="连接中…" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="MinButton" Grid.Column="2" Style="{StaticResource MinDot}" VerticalAlignment="Top" Margin="0,0,2,0" Visibility="Collapsed" ToolTip="最小化到任务栏"/>
                            <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource CloseDot}" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- 搜索：输入后只显示匹配的表情、动作、小剧场 -->
                        <Border Margin="0,12,8,0" CornerRadius="10" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" x:Name="SearchBorder" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M5,0.6 A4.4,4.4 0 1 0 5,9.4 A4.4,4.4 0 1 0 5,0.6 M8.3,8.3 L12,12" Stroke="{StaticResource SubBrush}" StrokeThickness="1.4" StrokeEndLineCap="Round" Margin="11,0,0,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}"
                                         FontFamily="{StaticResource UiFont}" FontSize="13" Padding="8,7" VerticalContentAlignment="Center" MaxLength="30"/>
                                <TextBlock x:Name="SearchHint" Grid.Column="1" Text="搜索表情、动作、小剧场（Ctrl+F）" Style="{StaticResource Caption}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="SearchClear" Grid.Column="2" Style="{StaticResource CloseDot}" Width="26" Height="26" Margin="0,0,3,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <Button.RenderTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Button.RenderTransform>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="22,14,22,12">

                    <Border x:Name="BondCard" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14,16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 羁绊 -->
                            <Grid x:Name="HeartRow" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 羁绊图标：同一条虎鲸尾巴逐级变化（BondIcon.cs 里画） -->
                                <Border x:Name="BondIconHost" Width="40" Height="40" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="关系值" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LevelHint" Text="初识" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock x:Name="PointsText" Grid.Column="2" Text="0" FontSize="23" FontWeight="SemiBold"
                                           Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <!-- 羁绊条：查看好感到了哪一档，竖条纹，亮度往前端渐强（样子照用户给的参考图） -->
                            <Border x:Name="BondTrack" Height="22" Margin="0,13,0,0" CornerRadius="11" Background="#060C26" BorderBrush="#6FA8E8" BorderThickness="1.4" SnapsToDevicePixels="True">
                                <Border.Resources>
                                    <DrawingBrush x:Key="BondStripes" TileMode="Tile" Viewport="0,0,6,40" ViewportUnits="Absolute" Viewbox="0,0,6,40" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,40"/></GeometryDrawing.Geometry></GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Resources>
                                <Grid x:Name="BondInner" Margin="7,4" SnapsToDevicePixels="True">
                                    <!-- 还没走到的部分：很暗的竖条 -->
                                    <Border Background="#1A2858" OpacityMask="{StaticResource BondStripes}"/>
                                    <!-- 走过的部分：左暗右亮 -->
                                    <Border x:Name="BondFill" HorizontalAlignment="Left" Width="0" OpacityMask="{StaticResource BondStripes}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#28489A" Offset="0"/>
                                                <GradientStop Color="#4A90D8" Offset="0.55"/>
                                                <GradientStop Color="#B5E6FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- 各档的节点和名字 -->
                            <Canvas x:Name="BondNodes" Height="34" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" CornerRadius="14"
                            BorderThickness="1" Padding="16,13" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="FocusButton" DockPanel.Dock="Right" Style="{StaticResource PillAccent}"
                                        Content="开始" MinWidth="64" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock x:Name="FocusTitle" Text="专注计时" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="FocusTime" Text="25:00" FontSize="27" FontWeight="SemiBold" Margin="0,2,0,0"
                                               Foreground="{StaticResource AccentBrush}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <ComboBox x:Name="FocusModePicker" MinWidth="100" Style="{StaticResource Picker}"
                                          DisplayMemberPath="Label" SelectedValuePath="Id" AutomationProperties.Name="计时方式"/>
                                <StackPanel x:Name="FocusMinutesRow" Orientation="Horizontal" Margin="9,0,0,0">
                                    <TextBox x:Name="FocusMinutesInput" Text="25" Width="55" MaxLength="3" Padding="7,4"
                                             Background="{StaticResource InputBrush}" Foreground="{StaticResource TextBrush}"
                                             BorderBrush="{StaticResource LineBrush}" CaretBrush="{StaticResource AccentBrush}"
                                             VerticalContentAlignment="Center" AutomationProperties.Name="倒计时分钟数"
                                             ToolTip="1 到 180 分钟，按回车或开始时保存"/>
                                    <TextBlock Text="分钟" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="FocusClockRow" Visibility="Collapsed" Orientation="Horizontal" Margin="9,0,0,0">
                                    <StackPanel.Resources>
                                        <Style x:Key="ClockPart" TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                        <Style x:Key="ClockNumber" TargetType="TextBox">
                                            <Setter Property="Width" Value="32"/>
                                            <Setter Property="MaxLength" Value="2"/>
                                            <Setter Property="Padding" Value="2,0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                        <Style x:Key="ClockArrow" TargetType="RepeatButton">
                                            <Setter Property="Width" Value="19"/>
                                            <Setter Property="Height" Value="15"/>
                                            <Setter Property="Delay" Value="350"/>
                                            <Setter Property="Interval" Value="95"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                            <Setter Property="BorderThickness" Value="1,0,0,0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border x:Name="ArrowFace" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ArrowFace" Property="Background" Value="{StaticResource CardLineBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="ArrowFace" Property="Opacity" Value="0.4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Border Style="{StaticResource ClockPart}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right">
                                                <RepeatButton x:Name="FocusHourUp" Content="▴" Style="{StaticResource ClockArrow}" AutomationProperties.Name="小时加一"/>
                                                <RepeatButton x:Name="FocusHourDown" Content="▾" Style="{StaticResource ClockArrow}" BorderThickness="1,1,0,0"
                                                              AutomationProperties.Name="小时减一"/>
                                            </StackPanel>
                                            <TextBox x:Name="FocusHourInput" Style="{StaticResource ClockNumber}" AutomationProperties.Name="小时"/>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Text="时" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="5,0,7,0"/>
                                    <Border Style="{StaticResource ClockPart}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right">
                                                <RepeatButton x:Name="FocusMinuteUp" Content="▴" Style="{StaticResource ClockArrow}" AutomationProperties.Name="分钟加一"/>
                                                <RepeatButton x:Name="FocusMinuteDown" Content="▾" Style="{StaticResource ClockArrow}" BorderThickness="1,1,0,0"
                                                              AutomationProperties.Name="分钟减一"/>
                                            </StackPanel>
                                            <TextBox x:Name="FocusMinuteInput" Style="{StaticResource ClockNumber}" AutomationProperties.Name="分钟"/>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Text="分" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="FocusHint" Style="{StaticResource Caption}" Visibility="Collapsed" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <ComboBox x:Name="SettingsPicker" Style="{StaticResource Picker}" DisplayMemberPath="Label" SelectedValuePath="Id"
                              AutomationProperties.Name="设置" Padding="12,7" Margin="0,0,0,12"/>

                    <Border x:Name="RelationshipDetails" Visibility="Collapsed" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,0,10">
                        <StackPanel>
                            <local:AffectionSettingsPanel x:Name="AffectionSettings"/>
                            <Button x:Name="TouchLinesShortcut" Content="互动台词" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="AppearanceDetails" Visibility="Collapsed">
                        <!-- 出场开关 -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="在桌面上出场" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ShowHint" Text="关掉就收起，她在后台待命" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="ShowSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 外观 -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14,16,8" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="大小" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="ScaleValue" Text="1.5×" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                                <Slider x:Name="ScaleSlider" Style="{StaticResource StarSlider}" Minimum="0.5" Maximum="2" SmallChange="0.1" LargeChange="0.1" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                                <Grid x:Name="ScaleMarks" Height="18" Margin="0,0,0,14"/>

                                <TextBlock Text="体型" Style="{StaticResource Caption}"/>
                                <Border x:Name="ShapeHost" Background="#6608102F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,16"/>

                                <TextBlock Text="衣服和配饰" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                                <WrapPanel x:Name="DressPanel"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14,16,14" Margin="0,2,0,12">
                            <StackPanel>
                                <TextBlock Text="流畅度（帧率）" Style="{StaticResource Caption}"/>
                                <Border x:Name="FpsHost" Background="#6608102F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,16"/>

                                <TextBlock Text="清晰度（立绘）" Style="{StaticResource Caption}"/>
                                <Border x:Name="QualityHost" Background="#6608102F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,16"/>

                                <Grid>
                                    <TextBlock Text="气泡大小" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="BubbleValue" Text="1.0×" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                                <Slider x:Name="BubbleSlider" Style="{StaticResource StarSlider}" Minimum="0.5" Maximum="2" SmallChange="0.1" LargeChange="0.1" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                                <Grid x:Name="BubbleMarks" Height="18" Margin="0,0,0,14"/>

                                <TextBlock Text="气泡停留" Style="{StaticResource Caption}"/>
                                <Border x:Name="StayHost" Background="#6608102F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,8">
                                    <TextBlock Text="视线跟着鼠标" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SwFollow" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <TextBlock Text="别的程序全屏时藏起来" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SwFull" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <TextBlock Text="跟随 Agent 一起启动" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SwStartHidden" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <TextBlock Text="拖到屏幕边弹回来" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SwKeepOn" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <TextBlock Text="在任务栏显示面板" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SwTaskbar" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8">
                                    <TextBlock Text="面板保持在最前" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="PinButton" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                  AutomationProperties.Name="面板保持在最前"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ActionsDetails" Visibility="Collapsed">
                        <!-- 常用：右键任意按钮加入 / 移出 -->
                        <Border x:Name="FavCard" Visibility="Collapsed" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12,16,4" Margin="0,6,0,12">
                            <StackPanel>
                                <TextBlock Text="★ 常用" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                                <WrapPanel x:Name="FavPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- 表情 / 动作 / 小剧场：可展开收起 -->
                        <StackPanel x:Name="SectionsHost"/>
                        <TextBlock x:Name="FavHint" Text="小技巧：右键点任意按钮，加入“★ 常用”，常用的就摆在最上面。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,0,4,8"/>
                        <TextBlock x:Name="EmptyHint" Visibility="Collapsed" Text="没有找到，换个词试试。" Style="{StaticResource Caption}" Margin="4,8,4,8"/>

                        <Button x:Name="ResetButton" Style="{StaticResource Ghost}" Content="恢复默认表情" Margin="0,0,0,8"/>
                    </StackPanel>

                    <Border x:Name="TouchDetails" Visibility="Collapsed" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,0,10">
                        <local:TouchSettingsPanel x:Name="TouchSettings"/>
                    </Border>

                    <Border x:Name="VoiceDetails" Visibility="Collapsed" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,0,10">
                        <StackPanel x:Name="VoiceSettings">
                            <Grid Margin="0,6">
                                <TextBlock Text="藤田琴音配音" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="SwVoiceEnabled" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="配音语言" VerticalAlignment="Center"/>
                                <ComboBox x:Name="VoiceLanguagePicker" Grid.Column="1" MinWidth="102" SelectedValuePath="Tag"
                                          Style="{StaticResource Picker}" AutomationProperties.Name="配音语言">
                                    <ComboBoxItem Tag="auto" Content="跟随台词"/>
                                    <ComboBoxItem Tag="ja" Content="日语"/>
                                    <ComboBoxItem Tag="zh" Content="中文"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="音量" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="VoiceVolumeValue" HorizontalAlignment="Right" Style="{StaticResource Caption}"/>
                            </Grid>
                            <Slider x:Name="VoiceVolumeSlider" Style="{StaticResource StarSlider}" Minimum="0" Maximum="1"
                                    Value="0.25" SmallChange=".05" LargeChange=".1" TickFrequency=".05" IsSnapToTickEnabled="True"/>
                            <Grid x:Name="VoiceVolumeMarks" Height="18"/>
                            <Border Height="1" Margin="0,12,0,4" Background="{StaticResource LineBrush}" Opacity="0.6"/>
                            <local:ConversationPanel x:Name="ConversationSettings"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="BehaviorDetails" Visibility="Collapsed">
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="小动作间隔" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="IdleValue" Text="40 秒" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                                <Slider x:Name="IdleSlider" Style="{StaticResource StarSlider}" Minimum="0" Maximum="15" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                                <Grid x:Name="IdleMarks" Height="18" Margin="0,0,0,14"/>

                                <!-- 随音乐摇摆：点开选认哪些声音；右边小字写着现在认的是哪几类（2026-11-17） -->
                                <ToggleButton x:Name="DanceFold" Style="{StaticResource SubFold}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="随音乐摇摆" VerticalAlignment="Center"/>
                                        <StackPanel x:Name="DanceTags" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,2,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel x:Name="DancePanel" Visibility="Collapsed" Margin="14,0,0,4">
                                    <Grid Margin="0,6">
                                        <TextBlock Text="识别音乐软件声音" VerticalAlignment="Center" Foreground="{StaticResource SubBrush}"/>
                                        <ToggleButton x:Name="SwDanceApps" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,6">
                                        <TextBlock Text="识别浏览器网页声音" VerticalAlignment="Center" Foreground="{StaticResource SubBrush}"/>
                                        <ToggleButton x:Name="SwDanceBrowser" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <!-- 摇摆强度（2026-11-18）：柔和（默认）/ 标准 / 激烈，听摇滚、电子可以选激烈 -->
                                    <TextBlock Text="摇摆强度" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                                    <Border x:Name="StrengthHost" Background="#6608102F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- 陪玩陪看（鱼眼，本机加 2026-11-18）：单独一栏，默认折叠；标题右边小字写着开没开，点开是开关、话量滑块和她现在在看什么 -->
                        <Border x:Name="EyeCard" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,6" Margin="0,0,0,12">
                            <StackPanel>
                                <ToggleButton x:Name="EyeFold" Style="{StaticResource SubFold}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="陪玩陪看" VerticalAlignment="Center"/>
                                        <StackPanel x:Name="EyeTags" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,2,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel x:Name="EyePanel" Visibility="Collapsed" Margin="14,0,0,8">
                                    <Grid Margin="0,6">
                                        <TextBlock Text="开启陪玩陪看" VerticalAlignment="Center" Foreground="{StaticResource SubBrush}"/>
                                        <ToggleButton x:Name="SwEye" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <StackPanel x:Name="EyeSliderBox" Margin="0,4,0,4">
                                        <Grid>
                                            <TextBlock Text="话多话少" Style="{StaticResource Caption}"/>
                                            <TextBlock x:Name="EyeSliderValue" Text="" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </Grid>
                                        <Slider x:Name="EyeSlider" Style="{StaticResource StarSlider}" Minimum="0.5" Maximum="2" Value="1" SmallChange="0.1" LargeChange="0.1" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                                        <Grid x:Name="EyeSliderMarks" Height="18"/>
                                    </StackPanel>
                                    <TextBlock x:Name="EyeNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border x:Name="ReminderDetails" Visibility="Collapsed" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- 睡觉提醒：默认折叠，标题右边写着几点（关着写“已关闭”）；点开是开关和时间滑块（2026-11-18） -->
                            <ToggleButton x:Name="SleepFold" Style="{StaticResource SubFold}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="睡觉提醒" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="SleepTags" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,2,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel x:Name="SleepPanel" Visibility="Collapsed" Margin="14,0,0,4">
                                <Grid Margin="0,6">
                                    <TextBlock Text="开启睡觉提醒" VerticalAlignment="Center" Foreground="{StaticResource SubBrush}"/>
                                    <ToggleButton x:Name="SwCoaxSleep" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel x:Name="SleepSliderBox" Margin="0,4,0,4">
                                    <Grid>
                                        <TextBlock Text="几点开始提醒" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="SleepSliderValue" Text="" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </Grid>
                                    <Slider x:Name="SleepSlider" Style="{StaticResource StarSlider}" Minimum="0" Maximum="16" Value="10" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                                    <Grid x:Name="SleepSliderMarks" Height="18"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- 午饭提醒：默认折叠，标题右边写着几点（关着写“已关闭”）；点开是开关和时间滑块（2026-11-18） -->
                            <ToggleButton x:Name="LunchFold" Style="{StaticResource SubFold}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="午饭提醒" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="LunchTags" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,2,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel x:Name="LunchPanel" Visibility="Collapsed" Margin="14,0,0,4">
                                <Grid Margin="0,6">
                                    <TextBlock Text="开启午饭提醒" VerticalAlignment="Center" Foreground="{StaticResource SubBrush}"/>
                                    <ToggleButton x:Name="SwCoaxLunch" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel x:Name="LunchSliderBox" Margin="0,4,0,4">
                                    <Grid>
                                        <TextBlock Text="几点提醒" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="LunchSliderValue" Text="" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </Grid>
                                    <Slider x:Name="LunchSlider" Style="{StaticResource StarSlider}" Minimum="0" Maximum="10" Value="2" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                                    <Grid x:Name="LunchSliderMarks" Height="18"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="UpdateDetails" Visibility="Collapsed" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,0,14">
                            <Button x:Name="UpdateButton" Style="{StaticResource Ghost}" Content="检查更新" HorizontalAlignment="Left" Padding="18,7"/>
                            <TextBlock x:Name="UpdateNote" Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>

                <!-- 操作结果有消息时才使用底栏。 -->
                <Border x:Name="Footer" Grid.Row="2" Visibility="{Binding Visibility, ElementName=Toast}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineBrush}" Background="#80050A1C" Padding="22,10,22,12">
                    <StackPanel>
                        <TextBlock x:Name="Toast" Text="" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- 顶栏上层的星光：只在抬头那一行的空白处（名字右边、图钉左边），压在顶栏半透明底色上面，所以看得清；不挡点击 -->
            <Canvas x:Name="TopSky" IsHitTestVisible="False" Width="372" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>
    </Border>
</Window>
