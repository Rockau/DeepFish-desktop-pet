<Application x:Class="FishTray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- 深海蓝 + 冰蓝点缀（方案 A） -->
        <Color x:Key="Bg0">#050A1C</Color>
        <Color x:Key="Bg1">#0B1640</Color>
        <Color x:Key="AccentC">#7CC4FF</Color>
        <SolidColorBrush x:Key="CardBrush" Color="#8C0E1B45"/>
        <SolidColorBrush x:Key="CardLineBrush" Color="#33466F"/>
        <SolidColorBrush x:Key="LineBrush" Color="#26396F"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8F0FF"/>
        <SolidColorBrush x:Key="SubBrush" Color="#8797C4"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7CC4FF"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#33265C9E"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#4D7CC4FF"/>
        <SolidColorBrush x:Key="InputBrush" Color="#B3081034"/>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 小标题 -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 开关 -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="42" Height="22" CornerRadius="11" Background="#16254F"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource SubBrush}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2B67B6"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 衣服配饰的小胶囊（可选中） -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" CornerRadius="14" Padding="13,6" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="Transparent">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{StaticResource SubBrush}" FontSize="12.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 点一下就做的小胶囊（不选中） -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="14" Padding="12,5" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="Transparent">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{StaticResource SubBrush}" FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分段选择 -->
        <Style x:Key="SegRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="8" Margin="2" Padding="0,6" Background="Transparent">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" HorizontalAlignment="Center" Foreground="{StaticResource SubBrush}" FontSize="12.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2B67B6"/>
                                <Setter TargetName="Label" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑块：粗一点的轨道、渐变填充、大一点的圆钮；整条都能按住拖（MainWindow.SmoothDrag），拖的时候圆钮上方冒出当前数值（Slider.Tag） -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!-- 轨道两头各缩进 9（圆钮半径），填充从轨道起点一直画到圆钮中心 -->
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="9,0,-9,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2F6FD0" Offset="0"/>
                                    <GradientStop Color="#7CC4FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderDot" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="18" Height="18">
                            <!-- 悬停 / 拖动时的光晕 -->
                            <Ellipse x:Name="Halo" Width="32" Height="32" Margin="-7" Fill="#337CC4FF" Opacity="0"/>
                            <Ellipse x:Name="Dot" Fill="#F7FAFF" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#7CC4FF" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <!-- 拖动时圆钮上方的数值小气泡 -->
                            <Canvas Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Border x:Name="Tip" Canvas.Left="-32" Canvas.Top="-31" Width="64" Height="23" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                                        Background="#F02B67B6" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Slider}}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Canvas>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.7"/>
                                <Setter TargetName="Dot" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.1" ScaleY="1.1"/></Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseCaptured, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                                <Setter TargetName="Dot" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.2" ScaleY="1.2"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                                <Setter TargetName="Tip" Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StarSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30" Background="Transparent">
                            <Border x:Name="Rail" Height="6" CornerRadius="3" Margin="9,0" Background="#1A2A5C" BorderBrush="#2A3F7A" BorderThickness="1" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderDot}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEmpty}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rail" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文本框 -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" CornerRadius="10" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="11,7">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 实心的主按钮（番茄钟“开始”）：蓝色渐变胶囊，悬停亮一点，按下沉一点 -->
        <Style x:Key="PillAccent" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="15" Padding="16,6" MinWidth="64" BorderThickness="1" BorderBrush="#7CC4FF" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3C82E0" Offset="0"/>
                                    <GradientStop Color="#2B5FB6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect><DropShadowEffect Color="#7CC4FF" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/></Border.Effect>
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" HorizontalAlignment="Center" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Effect"><Setter.Value><DropShadowEffect Color="#7CC4FF" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/></Setter.Value></Setter>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#B5DEFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="Tag" Value="stop">
                                <Setter TargetName="Box" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                <Setter TargetName="Box" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource SubBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="stop"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通按钮（描边） -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="10" Padding="14,7" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="Transparent">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" HorizontalAlignment="Center" Foreground="{StaticResource SubBrush}" FontSize="12.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右上角关闭 -->
        <Style x:Key="CloseDot" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Width="28" Height="28" CornerRadius="14" Background="Transparent">
                            <Path x:Name="Cross" Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource SubBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="Cross" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 最小化（只有开了“在任务栏显示面板”才露出来） -->
        <Style x:Key="MinDot" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Width="28" Height="28" CornerRadius="14" Background="Transparent">
                            <Path x:Name="Cross" Data="M0,0 L10,0" Stroke="{StaticResource SubBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="Cross" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- “更多设置” 整行 -->
        <Style x:Key="MoreRow" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" Height="34">
                            <TextBlock x:Name="Label" Text="更多设置" Foreground="{StaticResource SubBrush}" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                            <Path x:Name="Chevron" Data="M0,0 L5,5 L10,0" Stroke="{StaticResource SubBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                            </Path>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 可展开收起的大标题行（表情 / 动作 / 小剧场） -->
        <Style x:Key="FoldRow" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Height="42" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource CardLineBrush}" Background="{StaticResource CardBrush}" Padding="16,0,14,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="Title" Text="{TemplateBinding Content}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Caption}" Margin="9,2,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Path x:Name="Chevron" Data="M0,0 L5,5 L10,0" Stroke="{StaticResource SubBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏上的小图标按钮：置顶图钉 -->
        <Style x:Key="PinDot" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Width="28" Height="28" CornerRadius="14" Background="Transparent">
                            <Path x:Name="Pin" Data="M3,0 L9,0 M4,0 L4,5 L1,8.5 L11,8.5 L8,5 L8,0 M6,8.5 L6,13" Stroke="{StaticResource SubBrush}" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform Angle="40"/></Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="Pin" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="Pin" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Pin" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 提示框：深蓝底，和面板一致 -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F00B1640" BorderBrush="{StaticResource AccentSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" MaxWidth="260">
                            <ContentPresenter TextElement.Foreground="{StaticResource TextBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#3A5390" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
